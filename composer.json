{
    "name": "andydefer/laravel-cluster",
    "description": "A powerful cluster query parser and filter for Laravel with JSON column support",
    "autoload": {
        "psr-4": {
            "AndyDefer\\LaravelCluster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\LaravelCluster\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andy Kani",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0|^13.0|^14.0|^15.0",
        "andydefer/laravel-actions": "^2.11.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.29",
        "laravel/tinker": "^2.11"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndyDefer\\LaravelCluster\\Providers\\ClusterServiceProvider"
            ]
        }
    }
}
